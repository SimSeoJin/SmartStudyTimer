# 서버에서 `cp .env.example .env` 후 값을 채움. .env는 절대 커밋하지 말 것.
# 값 뒤에 주석을 붙이지 말고, 주석은 별도 줄에 작성.

# DB 계정 (root는 쓸 수 없음 - MySQL 이미지가 거부함)
DB_USERNAME=timer
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# JWT 서명 키: 32자 이상. 생성: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=2592000000

# 소셜 로그인 (쓰는 것만 채우면 됨)
KAKAO_CLIENT_ID=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_CLIENT_IDS=
